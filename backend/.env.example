# Copy to backend/.env for local dev. Without DATABASE_URL a local SQLite file is used.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres 16 (docker compose uses postgres://happy:happy@db:5432/happy)
# DATABASE_URL=postgres://happy:***@db:5432/happy
ALLOWED_ORIGINS=http://localhost:3000
# Public origin of this API; used for absolute image URLs (prod: https://api.happyservices.in)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Behind Nginx/a load balancer, set to the number of proxies so throttling sees the real client IP
# NUM_PROXIES=1

# Notifications. Without EMAIL_URL emails print to the console.
NOTIFY_EMAIL_TO=newhappyservices@gmail.com
DEFAULT_FROM_EMAIL=Happy Services <bookings@happyservices.in>
# EMAIL_URL=smtp+tls://resend:<api-key>@smtp.resend.com:587
# Gmail (needs an app password; write the @ in the username as %40):
# EMAIL_URL=smtp+tls://you%40gmail.com:<app-password>@smtp.gmail.com:587
# DEFAULT_FROM_EMAIL=you@gmail.com
# Without REDIS_URL, Celery tasks run inline (fine for dev; use Redis in prod)
# REDIS_URL=redis://redis:6379/0

FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me
IP_HASH_SALT=change-me
# SENTRY_DSN=
# Prod only: DJANGO_SETTINGS_MODULE=config.settings.prod, CSRF_TRUSTED_ORIGINS=https://api.happyservices.in
