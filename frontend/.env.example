# Public site URL (prod: https://www.happyservices.in — confirm domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side fetches at build time and for ISR
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Booking POST and click events from the browser
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# GA4 measurement ID, e.g. G-XXXXXXX (empty disables analytics)
NEXT_PUBLIC_GA_ID=
# Must match the backend's REVALIDATE_SECRET
REVALIDATE_SECRET=change-me
